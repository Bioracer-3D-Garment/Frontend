NEXT_PUBLIC_API_URL=http://localhost:8000
# Example: NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Cloudinary cloud name — required by next-cloudinary <CldImage> to render images by public ID
# (used for generated assets and model pose/cover thumbnails).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Copy this file to .env.local and update values for local development (do NOT commit secrets)

